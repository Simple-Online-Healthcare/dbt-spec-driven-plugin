# Automation Configuration
#
# Copy this file to config.env and fill in your actual values.
# config.env is gitignored — it never leaves your machine.
#
# The register scripts source this file and substitute these values
# into the prompt templates before registering the automation.

# Git repo URL (used in Step 1 of both prompts)
REPO_URL=https://github.com/your-org/your-dbt-project.git

# Jira domain (e.g. acme.atlassian.net)
JIRA_DOMAIN=your-domain.atlassian.net

# Jira project key
JIRA_PROJECT=DATA

# dbt Cloud run URL prefix (account and project IDs)
DBT_CLOUD_RUN_URL_PREFIX=https://cloud.getdbt.com/deploy/<your-account-id>/projects/<your-project-id>/runs/

# Awin affiliate network
AWIN_ADVERTISER_ID=<your-advertiser-id>
AWIN_VOUCHER_PARAM=<your-voucher-param-number>
